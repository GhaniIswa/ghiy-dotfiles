#!/usr/bin/env zsh

for cmd in fzf yt-dlp mpv; do
    if ! (( $+commands[$cmd] )); then
        echo "Error: Required command '$cmd' is not installed." >&2
        exit 1
    fi
done

if [[ $# -eq 0 ]]; then
    echo -n "Insert title: "
    read -r user_query
    [[ -z "$user_query" ]] && exit 0
else
    user_query="$*"
fi

echo "Searching: $user_query..."

selected=$(yt-dlp "ytsearch10:$user_query" \
    --print "%(title)s___%(id)s" \
    --no-playlist \
    --socket-timeout 5 2>/dev/null | awk -F'___' '{print $1 " \033[36m[" $2 "]\033[0m"}' | fzf --ansi --prompt="Choose song > " --height=40% --layout=reverse)

[[ -z "$selected" ]] && { echo "Exit."; exit 0; }

video_id=$(echo "$selected" | grep -oE '\[[^]]+\]' | tr -d '[]')

song_title=$(echo "$selected" | sed 's/ \x1b\[[0-9;]*m\[.*\]\x1b\[0m//')

if [[ -n "$video_id" ]]; then
    clear
    echo "Loading please wait..."

    playlist_url="https://www.youtube.com/watch?v=${video_id}&list=RD${video_id}"
    
    mpv --no-video \
        --cache=no \
        --ytdl-raw-options=yes-playlist= \
        --loop-playlist=inf \
        "$playlist_url"
fi
