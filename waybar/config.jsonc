{
    "layer": "top",
    "position": "top",
    "spacing": 2,
    "margin-top": 14,
    "margin-left": 300,
    "margin-right": 300,
    "margin-bottom": -8,
    "exclusive": true,
    "gtk-layer-shell": true,

    "modules-left": [
        "hyprland/workspaces",
        "clock"
    ],
    "modules-center": [
        "hyprland/window"
    ],
    "modules-right": [
        "custom/nowplaying",
        "tray",
        "network",
        "pulseaudio",
        "backlight",
        "battery"
    ],

    // --- Modul ---
    "hyprland/workspaces": {
        "disable-scroll": true,
        "all-outputs": true,
        "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({workspace=\"e+1\"})' ",
        "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({workspace=\"e-1\"})' ",
        "format": "{icon}",
        "sort-by": "id",
        "format-icons": {
            "Windows": "W",
            "Gaming": "G",
            "1": "1",
            "2": "2",
            "3": "3",
            "4": "4"
        }
    },

    "hyprland/window": {
        "format": "{title}",
        "max-length": 50,
        "on-click": "activate",
        "separate-outputs": true,
        "rewrite": {
            "": "Arch Linux"
        }
    
    },

    "clock": {
        "format": "{:%H:%M}",
        "tooltip": false
    },

    "network": {
        "format-wifi": " ",
        "format-alt": "{essid}",
        "format-disconnected": "X",
        "max-length": 20,
        "tooltip": false
    },

    "backlight": {
        "format": "{icon}  {percent}%",
        "format-icons": ["󰃞 ", "󰃟 ", "󰃠 "],
        "on-click": "",
        "on-scroll-up": "brightnessctl set 1%+",
        "on-scroll-down": "brightnessctl set 1%-",
        "tooltip": false
    },

    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "󰝟  Muted",
        "format-icons": {
        "headphone": "󰋋 ",
        "hands-free": "󰋋 ",
        "headset": "󰋋 ",
        "phone": "󰏲",
        "portable": "󰏲",
        "car": "󰆋",
        "default": ["󰕿 ", "󰖀 ", "󰕾 "]
        },
        "on-click": "pavucontrol",
        "on-scroll-up": "wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 5%+",
        "on-scroll-down": "wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 5%-",
        "tooltip": false
    },

    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "Battery: {capacity}%",
        "format-full": "",
        "format-charging": "󱐋 {capacity}%"
    },

    "custom/nowplaying": {
        "format": " 󰝚  {} ",
        "return-type": "json",
        "max-length": 25,
        "exec": "playerctl -a metadata --format '{\"text\": \"{{title}}\", \"alt\": \"{{status}}\", \"class\": \"{{status}}\"}' -F",
        "on-click": "playerctl play-pause",
        "on-scroll-up": "playerctl next",
        "on-scroll-down": "playerctl previous"
    }
}
