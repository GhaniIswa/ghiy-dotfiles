{
    "layer": "top",
    "position": "top",
    "spacing": 0,
    "height": 27,
    "margin-top": 14,
    "margin-left": 300,
    "margin-right": 300,
    "margin-bottom": -8,
    "exclusive": true,
    "gtk-layer-shell": true,

    "modules-left": [
        "hyprland/workspaces",
        "hyprland/window"
    ],
    "modules-center": [
        "memory"
    ],
    "modules-right": [
        "custom/nowplaying",
        "tray",
        "network",
        "pulseaudio",
        "backlight",
        "battery",
        "clock"
    ],

    // --- Modul ---
    "hyprland/workspaces": {
        "disable-scroll": true,
        "all-outputs": true,
        "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({workspace=\"e+1\"})' ",
        "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({workspace=\"e-1\"})' ",
        "format": "{icon}",
        "sort-by": "id",
        "format-icons": {
            "Windows": "W",
            "Gaming": "G",
            "1": "1",
            "2": "2",
            "3": "3",
            "4": "4"
        }
    },

    "hyprland/window": {
        "format": "{title}",
        "max-length": 100,
        "icon": true,
        "icon-size": 18,
        "separate-outputs": true,
        "tooltip": true,
        "rewrite": {
            "": "Arch Linux"
        }
    },

    "clock": {
        "format": "{:%I:%M %p} ",
        "tooltip": false
    },
    
    "memory": {
        "format": "󰍛  {used:0.1f} GB / {total:0.1f} GB",
        "tooltip": false
    },

    "network": {
        "format-wifi": "{icon}",
        "format-icons": [
            "󰤯",
            "󰤟",
            "󰤢",
            "󰤥",
            "󰤨"
        ],
        "tooltip": true,
        "tooltip-format": "connected to {essid}"
    },

    "backlight": {
        "format": "{icon}  {percent}%",
        "format-icons": ["󰃞 ", "󰃟 ", "󰃠 "],
        "on-click": "",
        "on-scroll-up": "brightnessctl set 1%+",
        "on-scroll-down": "brightnessctl set 1%-",
        "tooltip": false
    },

    "pulseaudio": {
        "format": "{icon}  {volume}%",
        "format-muted": "󰝟  Muted",
        "format-icons": {
            "headphone": "󰋋 ",
            "hands-free": "󰋋 ",
            "headset": "󰋋 ",
            "phone": "󰏲",
            "portable": "󰏲",
            "car": "󰆋",
            "default": ["󰕿 ", "󰖀 ", "󰕾 "]
        },
        "on-click": "pavucontrol",
        "on-scroll-up": "wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 5%+",
        "on-scroll-down": "wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 5%-",
        "tooltip": false
    },

    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{icon} {capacity}%",
        "format-full": "",
        "format-plugged": "",
        "format-charging": "",
        "format-icons": [
            "󰁺",
            "󰁻",
            "󰁼",
            "󰁽",
            "󰁾",
            "󰁿",
            "󰂀",
            "󰂁",
            "󰂂",
            "󰁹"
        ]
    },

    "custom/nowplaying": {
        "format": "󰝚  {} ",
        "return-type": "json",
        "max-length": 100,
        "exec": "playerctl -a metadata --format '{\"text\": \"{{markup_escape(title)}}\", \"alt\": \"{{status}}\", \"class\": \"{{status}}\"}' -F",
        "on-click": "playerctl play-pause",
        "on-scroll-up": "playerctl next",
        "on-scroll-down": "playerctl previous"
    }
}
